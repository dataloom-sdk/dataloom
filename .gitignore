# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files (except the committed Gradle wrapper JAR)
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Gradle build output and caches
build/
.gradle/

# Gradle wrapper JAR must be committed; exclude all other JARs
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Generated plugin metadata must never be committed at repository root.
/META-INF/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# IDE files
.idea/
*.iml
*.ipr
*.iws

# macOS metadata
.DS_Store

# Apple/Kotlin-Native generated artifacts
# XCFramework build outputs produced by assembleDataLoomReleaseXCFramework /
# assembleDataLoomDebugXCFramework tasks.  Do not commit generated binaries.
*.xcframework/
*.xcarchive/
dataloom-apple/build/XCFrameworks/

# Swift Package Manager build artifacts produced by the apple-smoke fixture.
apple-smoke/.build/
apple-smoke/DataLoom.xcframework/
